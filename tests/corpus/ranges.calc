# source: original; ranges and element-wise lists, worked by hand
k := 0..4
squares := k ^ 2
total := sum(squares)
average := mean(k)
spread := stdev(k)
spread_s := stdev_sample(k)
smallest := min(squares)
largest := max(squares)
count := length(k)
third := squares[3]
stepped := 0, 2..10
stepped_total := sum(stepped)
down := 10, 7.5..0
down_total := sum(down)
lengths := 0 m..3 m
longest := max(lengths)
scaled_total := sum(2 * lengths)
root_total := sum(sqrt(k))
dotted := dot(vec(k), vec(k))
above := sum(k > 2)
parabola := sum(k ^ 2 - 2 * k)
shifted := sum(k + 10)
negated := sum(-k)
paired := sum(k * k)
quotient := sum(squares / (k + 1))
fine_steps := 0, 0.1..0.3
fine_total := sum(fine_steps)
single := 5..5
backwards := 3..1
