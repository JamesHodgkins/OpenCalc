# source: standard values: sin(pi/6) = 1/2, cos(0) = 1, ln(e^2) = 2, tan(pi/4) = 1,
#   and sqrt(2)^2 = 2. Angles are in radians; pi/6 = 0.5235987755982988 and
#   pi/4 = 0.7853981633974483 (double-precision values)
sin_val := sin(0.5235987755982988)
cos_val := cos(0)
log_val := ln(exp(2))
root_val := sqrt(2) ^ 2
tan_val := tan(0.7853981633974483)
=> sin_val ~1e-12 = 0.5
=> cos_val ~1e-12 = 1
=> log_val ~1e-12 = 2
=> root_val ~1e-12 = 2
=> tan_val ~1e-12 = 1
