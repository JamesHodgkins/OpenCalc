# source: original; solutions known in closed form (y' = y gives e^t; y' = 2t gives 1 + t^2; free fall x = x0 - g t^2 / 2, v = -g t; the oscillator y'' = -y gives cos and -sin)
growth := odesolve(y, t, y, 0, 1, 1)
ramp := odesolve(2 * t, t, y, 0, 1, 3)
backwards := odesolve(y, t, y, 1, exp(1), 0)
decay := odesolve(-y / (2 s), t, y, 0 s, 8 kg, 4 s)
oscillator := odesolve(vec(y[1], 0 - y[0]), t, y, 0, vec(1, 0), 1)
fall := odesolve(vec(y[1], -9.80665 m / s ^ 2), t, y, 0 s, vec(100 m, 0 m / s), 3 s)
table := odesolve(y, t, y, 0, 1, 1, 4)
times := col(table, 0)
values := col(table, 1)
last_row := row(table, 4)
trajectory := odesolve(vec(y[1], -9.80665 m / s ^ 2), t, y, 0 s, vec(100 m, 0 m / s), 2 s, 2)
drop_times := col(trajectory, 0)
heights := col(trajectory, 1)
blowup := odesolve(y ^ 2, t, y, 0, 1, 2)
bad_units := odesolve(y, t, y, 0 s, 1 m, 1 s)
bad_time := odesolve(y, t, y, 0 s, 1, 1 m)
wrong_shape := odesolve(1, t, y, 0, vec(1, 2), 1)
same_names := odesolve(y, t, t, 0, 1, 1)
too_few := odesolve(y, t, y, 0, 1)
complex_state := odesolve(y, t, y, 0, i, 1)
bad_column := col(table, 5)
not_a_matrix := col(3, 0)
=> growth ~1e-8 = exp(1)
=> ramp ~1e-8 = 10
=> backwards ~1e-8 = 1
=> decay ~1e-8 = 8 kg * exp(0 - 2)
=> oscillator ~1e-7 = vec(cos(1), 0 - sin(1))
=> fall ~1e-8 = vec(100 m - 0.5 * 9.80665 m / s ^ 2 * (3 s) ^ 2, -9.80665 m / s ^ 2 * 3 s)
=> times ~1e-12 = vec(0, 0.25, 0.5, 0.75, 1)
=> values ~1e-8 = vec(exp(0), exp(0.25), exp(0.5), exp(0.75), exp(1))
=> last_row ~1e-8 = mat(1, 2, 1, exp(1))
=> drop_times ~1e-12 = vec(0 s, 1 s, 2 s)
=> heights ~1e-8 = vec(100 m, 100 m - 0.5 * 9.80665 m / s ^ 2 * (1 s) ^ 2, 100 m - 0.5 * 9.80665 m / s ^ 2 * (2 s) ^ 2)
!> blowup : invalid
!> bad_units : mismatch
!> bad_time : mismatch
!> wrong_shape : invalid
!> same_names : invalid
!> too_few : invalid
!> complex_state : invalid
!> bad_column : invalid
!> not_a_matrix : invalid
