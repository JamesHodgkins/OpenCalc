# source: original; systems and optima worked by hand (circle x^2+y^2=25 with line x-y=1 meets at (4,3); least-squares line through (0,1),(1,3),(2,4) is slope 3/2, intercept 7/6)
x := 1
y := 1
a := 1
b := 0 - 1
side := 1 m
other := 1 m
slope := 0
reaction := 1 N
moment := 1 N * m
intercept := 0
u := 0
v := 0
circle := find(x, y, x ^ 2 + y ^ 2 == 25, x - y == 1)
one_unknown := find(a, a ^ 2 == 2)
positive_root := find(a, a ^ 2 == 4, a > 0)
negative_root := find(b, b ^ 2 == 4, b < 0)
wrong_side := find(a, a ^ 2 == 4, a < 0)
square_side := find(side, side ^ 2 == 4 m ^ 2)
two_lengths := find(side, other, side + other == 10 m, side - other == 2 m)
fitted_line := minerr(slope, intercept, intercept == 1, slope + intercept == 3, 2 * slope + intercept == 4)
bowl := minimize((u - 3) ^ 2 + 2 * (v + 1) ^ 2, u, v)
hill := maximize(0 - (u - 1) ^ 2, u)
on_a_line := minimize(u ^ 2 + v ^ 2, u, v, u + v == 2)
at_a_wall := minimize((u - 3) ^ 2, u, u <= 1)
infeasible := find(a, a ^ 2 == 0 - 1)
no_guess := find(never_defined, never_defined == 1)
not_a_constraint := find(a, a + 1)
mixed_unknowns := find(side, a, side == 3 m, a == 2)
reactions := find(reaction, moment, reaction == 10 N, moment == 2 m * reaction)
unit_mismatch := find(a, a == 1 m)
no_constraints := find(a)
listed_twice := find(a, a, a == 1)
=> circle ~1e-8 = vec(4, 3)
=> one_unknown ~1e-8 = sqrt(2)
=> positive_root ~1e-8 = 2
=> negative_root ~1e-8 = 0 - 2
=> square_side ~1e-8 = 2 m
=> two_lengths ~1e-8 = vec(6 m, 4 m)
=> mixed_unknowns ~1e-8 = vec(3 m, 2)
=> reactions ~1e-8 = vec(10 N, 20 N * m)
=> fitted_line ~1e-6 = vec(1.5, 7 / 6)
=> bowl ~1e-5 = vec(3, 0 - 1)
=> hill ~1e-5 = 1
=> on_a_line ~1e-5 = vec(1, 1)
=> at_a_wall ~1e-5 = 1
!> wrong_side : invalid
!> infeasible : invalid
!> no_guess : invalid
!> not_a_constraint : invalid
!> unit_mismatch : mismatch
!> no_constraints : invalid
!> listed_twice : invalid
