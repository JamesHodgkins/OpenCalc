# source: original; the M2.1 syntax worked by hand
v := [3, 4]
col := [1; 2; 3]
M := [1, 2; 3, 4]
forces := [3 N; 4 N]
first := v[0]
last := col[2]
corner := M[1, 0]
cell_with_units := forces[1]
chosen := if(2 > 1, 10 m, 20 m)
lazy := if(0 == 0, 5, 1 / 0)
chosen_else := if(3 <= 2, 1, 2)
same := 2 m == 200 cm
differ := 2 m != 3 m
order := 1 kN < 2000 N
unicode_le := 2 ≤ 2
unicode_ne := 1 ≠ 1
nested := [1, 2; 3, 4][1, 1] + M[0, 0]
inside_function := det([1, 2; 3, 4])
arithmetic_on_compare := (1 < 2) + (2 < 1) + (3 == 3)
=> first = 3
=> last = 3
=> corner = 3
=> cell_with_units = 4 N
=> chosen = 10 m
=> lazy = 5
=> chosen_else = 2
=> same = 1
=> differ = 1
=> order = 1
=> unicode_le = 1
=> unicode_ne = 0
=> nested = 5
=> inside_function = 0 - 2
=> arithmetic_on_compare = 2
=> M = mat(2, 2, 1, 2, 3, 4)
=> v = [3, 4]
