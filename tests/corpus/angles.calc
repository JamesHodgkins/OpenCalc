# source: original; standard angles worked by hand (30 deg = pi/6, sin 30 deg = 1/2, 45 deg = pi/4, 180 deg = pi)
half_turn := 180 deg
one_radian := 1 rad
sine_thirty := sin(30 deg)
cosine_sixty := cos(60 deg)
tangent_forty_five := tan(45 deg)
back_to_degrees := asin(0.5) / deg
quadrant_angle := atan2(1, 1) / deg
sum_of_angles := 30 deg + 60 deg
double_angle := 2 * 15 deg
right_angle := acos(0) / deg
=> half_turn = 3.141592653589793
=> one_radian = 1
=> sine_thirty ~1e-12 = 0.5
=> cosine_sixty ~1e-12 = 0.5
=> tangent_forty_five ~1e-12 = 1
=> back_to_degrees ~1e-12 = 30
=> quadrant_angle ~1e-12 = 45
=> sum_of_angles = 1.5707963267948966
=> double_angle = 0.5235987755982988
=> right_angle ~1e-12 = 90
