# source: original; the M2 exit worksheet. A beam check with units, a range of
# stations, matrices and complex numbers. Expected values were computed with plain
# Python arithmetic, independently of the engine, and are in SI base units.
# The harness evaluates it in every layout order, so the order here does not matter.
L := 6 m
w := 12 kN / m
P := 20 kN
b := 200 mm
h := 400 mm
E := 200000 MPa
fy := 355 MPa
gamma := 1.5
A := b * h
I := b * h ^ 3 / 12
S := I / (h / 2)
r := sqrt(I / A)
R_w := w * L / 2
R_p := P / 2
R := R_w + R_p
M_w := w * L ^ 2 / 8
M_p := P * L / 4
M := M_w + M_p
V := R
sigma := M / S
tau := 3 * V / (2 * A)
util := sigma / (fy / gamma)
ok := if(util < 1, 1, 0)
d_w := 5 * w * L ^ 4 / (384 * E * I)
d_p := P * L ^ 3 / (48 * E * I)
d := d_w + d_p
limit := L / 360
d_ratio := d / limit
rho := 7850 kg / m ^ 3
mass := rho * A * L
weight := mass * 9.80665 m / s ^ 2
w_self := weight / L
self_ratio := w_self / w
L_ft := L / 1 ft
M_kipft := M / (1 kip * 1 ft)
x := 0 m, 1 m..6 m
Mx := R * x - w * x ^ 2 / 2 - P * (x - L / 2) * (x > L / 2)
Mmax := max(Mx)
Mmean := mean(Mx)
npoints := length(x)
M_mid := Mx[3]
sig_x := Mx / S
sig_max := max(sig_x)
forces := [10 kN; 20 kN; 15 kN]
arms := [1 m; 2 m; 3 m]
moment := dot(forces, arms)
K := [2, 1; 1, 3] * 1000 kN / m
detK := det(K)
u := [1 mm; 2 mm]
Fv := K * u
F0 := Fv[0]
F1 := Fv[1]
z := 3 + 4 * i
zmod := abs(z)
zroot := sqrt(0 - 9)
bad_sum := L + P
bad_dependent := bad_sum * 2
bad_range := (0..5) + (0..3)
=> L ~1e-9 = 6.0 m
=> w ~1e-9 = 12000.0 N / m
=> P ~1e-9 = 20000.0 N
=> b ~1e-9 = 0.2 m
=> h ~1e-9 = 0.4 m
=> E ~1e-9 = 200000000000.0 Pa
=> fy ~1e-9 = 355000000.0 Pa
=> gamma ~1e-9 = 1.5
=> A ~1e-9 = 0.08000000000000002 m^2
=> I ~1e-9 = 0.001066666666666667 m^4
=> S ~1e-9 = 0.005333333333333334 m^3
=> r ~1e-9 = 0.11547005383792516 m
=> R_w ~1e-9 = 36000.0 N
=> R_p ~1e-9 = 10000.0 N
=> R ~1e-9 = 46000.0 N
=> M_w ~1e-9 = 54000.0 N*m
=> M_p ~1e-9 = 30000.0 N*m
=> M ~1e-9 = 84000.0 N*m
=> V ~1e-9 = 46000.0 N
=> sigma ~1e-9 = 15749999.999999998 Pa
=> tau ~1e-9 = 862499.9999999999 Pa
=> util ~1e-9 = 0.06654929577464788
=> ok ~1e-9 = 1.0
=> d_w ~1e-9 = 0.0009492187499999999 m
=> d_p ~1e-9 = 0.00042187499999999994 m
=> d ~1e-9 = 0.00137109375 m
=> limit ~1e-9 = 0.016666666666666666 m
=> d_ratio ~1e-9 = 0.082265625
=> rho ~1e-9 = 7850.0 kg / m^3
=> mass ~1e-9 = 3768.000000000001 kg
=> weight ~1e-9 = 36951.457200000004 N
=> w_self ~1e-9 = 6158.5762 N / m
=> self_ratio ~1e-9 = 0.5132146833333334
=> L_ft ~1e-9 = 19.68503937007874
=> M_kipft ~1e-9 = 61.95522053929029
=> Mmax ~1e-9 = 84000.0 N*m
=> Mmean ~1e-9 = 42857.142857142855 N*m
=> npoints ~1e-9 = 7.0
=> M_mid ~1e-9 = 84000.0 N*m
=> sig_max ~1e-9 = 15749999.999999998 Pa
=> moment ~1e-9 = 95000.0 N*m
=> detK ~1e-9 = 5000000000000.0 N^2 / m^2
=> F0 ~1e-9 = 4000.0 N
=> F1 ~1e-9 = 7000.0 N
=> zmod ~1e-9 = 5.0
=> zroot = 3 * i
=> z = 3 + 4 * i
=> x = 0 m, 1 m..6 m
!> bad_sum : mismatch
!> bad_dependent : mismatch
!> bad_range : value
