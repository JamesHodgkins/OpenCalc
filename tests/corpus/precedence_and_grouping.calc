# source: standard operator precedence: power binds tighter than unary minus and is
#   right-associative; * and / bind tighter than + and -; subtraction and division
#   are left-associative
p1 := 2 ^ 3 ^ 2
p2 := -2 ^ 2
p3 := (1 + 2) * 3
p4 := 10 - 3 - 2
p5 := 2 ^ -1
p6 := 8 / 4 / 2
p7 := 1 + 2 * 3
p8 := -(2 + 3)
p9 := 2 * -3
=> p1 = 512
=> p2 = -4
=> p3 = 9
=> p4 = 5
=> p5 = 0.5
=> p6 = 1
=> p7 = 7
=> p8 = -5
=> p9 = -6
